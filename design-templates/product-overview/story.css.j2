/* Instagram Story layout; main landscape styles remain unchanged. */
body{width:1080px;height:1920px}
body{padding:32px}
header{height:190px;padding:0 12px}
h1{font-size:68px;line-height:72px;height:86px;max-width:800px;margin-top:12px}
.category{font-size:26px;line-height:36px}
.eyebrow{font-size:10px;letter-spacing:1.4px;right:8px}
main{display:grid;grid-template-columns:minmax(0,1fr);gap:16px;height:1030px;grid-template-rows:584px 430px}
.hero{padding:16px 28px 24px;display:grid;grid-template-rows:minmax(0,1fr) 46px;gap:6px}
.hero img{height:100%;min-height:0;width:100%}
.caption{margin:0 12px;font-size:30px;line-height:42px;height:46px}
.right{grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:272px 142px;gap:16px}
.detail-copy{width:66%;padding:24px 0 20px 24px}
.detail-copy h2{max-width:220px;font-size:34px;line-height:39px;height:86px;margin-bottom:8px;letter-spacing:-1px}
.detail p{font-size:16px;line-height:23px;max-width:228px}
.detail-media{width:44%;clip-path:polygon(36% 0,100% 0,100% 100%,0 100%)}
.detail img{height:100%;min-height:272px}
.alternate{padding:12px 20px;display:flex;flex-direction:column;align-items:center}
.alternate img{height:180px;min-height:0;flex:1}
.alternate-title{font-size:22px;line-height:32px;flex-shrink:0}
.alternate-note{font-size:16px;line-height:24px;flex-shrink:0}
.dimensions{grid-column:1 / -1;padding:18px 30px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);column-gap:24px;align-content:center}
.dim-label{grid-column:1;font-size:18px;line-height:26px}
.size{grid-column:1;grid-row:2;font-size:36px;line-height:48px;height:48px;letter-spacing:-1px;margin:0}
.axis{grid-column:2;grid-row:2;font-size:20px;line-height:32px;align-self:center}
.note{grid-column:2;grid-row:1;font-size:12px;line-height:22px;margin:0;align-self:end}
footer{margin:24px 10px 0;font-size:10px;letter-spacing:1px}
body{padding:96px 48px 120px}
header{height:220px}
main{height:1420px;grid-template-rows:850px 554px}
.right{grid-template-rows:360px 178px}
.detail img{min-height:360px}
.detail-copy{padding-top:38px}
.eyebrow{display:none}
.dimensions{grid-template-columns:1fr;row-gap:0;padding:16px 32px}
.dim-label{grid-column:1;grid-row:1}
.size{grid-column:1;grid-row:2;font-size:42px;line-height:56px;height:58px}
.axis{grid-column:1;grid-row:3}
.note{grid-column:1;grid-row:4}
