<!doctype html>
<html lang="en"><meta charset="utf-8"><title>{{ product.name }} — Rishe</title>
<style>
@font-face{font-family:Manrope;src:url('{{ font }}') format('woff2');font-style:normal;font-weight:200 800;font-display:block}
*{box-sizing:border-box}
:root{--canvas:#f5f4f0;--hero:#f1eee9;--detail:#e8e3d6;--alternate:#fbf9f7;--forest:#2a403a}
body{margin:0;width:1536px;height:1024px;background:var(--canvas);color:#2a3d39;font-family:Manrope,sans-serif;font-synthesis:none;padding:28px 42px;line-height:1.35}
header{height:214px;position:relative;padding:0 18px}.brand{display:flex;align-items:center;gap:14px;height:36px;font-weight:600;font-size:32px;line-height:36px;letter-spacing:-1px;color:#2f2e2e}.brand-logo{height:34px;width:auto;flex-shrink:0;color:#2a3d39}.brand-divider{height:34px;width:2px;background:#cbbcac;flex-shrink:0}
h1{font-size:76px;line-height:76px;letter-spacing:-2.4px;margin:16px 0 0;font-weight:800;max-width:1000px;height:90px}
.category{font-size:28px;line-height:36px;font-weight:500;color:#93998f}.eyebrow{position:absolute;right:8px;top:8px;font-size:13px;font-weight:600;letter-spacing:2px;color:#875d45}
main{height:704px;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:16px}.card{border-radius:24px;overflow:hidden;position:relative}
.hero{background:var(--hero);display:flex;flex-direction:column;padding:28px 28px 36px}.hero img{width:100%;height:564px;object-fit:contain;filter:drop-shadow(0 12px 9px rgba(65,48,28,.13))}.caption{font-size:34px;line-height:46px;font-weight:700;letter-spacing:-.8px;margin:14px 28px 0;height:48px;flex-shrink:0}
.right{display:grid;grid-template-rows:250px 216px 206px;gap:16px;min-width:0}
.detail{background:var(--detail)}.detail-copy{position:relative;width:56%;padding:46px 0 24px 54px;z-index:1}.detail-copy h2{max-width:270px}.detail-media{position:absolute;inset:0 0 0 auto;width:62%;overflow:hidden;clip-path:polygon(25% 0,100% 0,100% 100%,0 100%)}
h2{font-size:44px;line-height:49px;letter-spacing:-1.3px;margin:0 0 8px;font-weight:700;height:104px;overflow-wrap:break-word}.detail p{font-size:19px;font-weight:500;margin:5px 0;line-height:26px;max-height:52px}.detail img{width:100%;height:250px;object-fit:cover;transform:scale({{ product.detail_crop.scale }});transform-origin:{{ product.detail_crop.x }}% {{ product.detail_crop.y }}%}
.alternate{background:var(--alternate);text-align:center;padding:12px 24px}.alternate img{width:100%;height:132px;object-fit:contain}.alternate-title{font-size:24px;line-height:32px;font-weight:700;letter-spacing:-.4px;height:32px}.alternate-note{font-size:18px;line-height:25px;color:#998573;margin-top:2px}
.dimensions{background:var(--forest);color:#f5f4f0;padding:24px 54px}.dim-label{font-size:23px;line-height:30px;font-weight:400}.size{font-size:48px;line-height:62px;font-weight:600;letter-spacing:-1.5px;margin:2px 0;white-space:nowrap;height:62px;font-variant-numeric:lining-nums}.axis{font-size:26px;line-height:36px;font-weight:400}.note{font-size:14px;line-height:22px;margin-top:7px;max-height:24px}
footer{display:flex;justify-content:space-between;margin:28px 14px 0;font-size:12px;line-height:18px;letter-spacing:1.5px;color:#875d45}footer span{max-width:48%}
{% if layout == 'story' %}{% include 'story.css.j2' %}{% endif %}
</style>
<header><div class="brand"><svg class="brand-logo" viewBox="0 0 184.734 255.978" fill="currentColor" aria-hidden="true"><g transform="translate(77.256 114.004) scale(1 -1)"><path d="M-75.445-105.606a34.556 34.556 0 0 1 69.113 0V112.193a72.118 72.118 0 0 1-69.113-77.624v-140.175Z"/><path d="M13.668 112.193v-179.61a77.89 77.89 0 0 1 70.881-70.916l21.118-1.829-10.012 32.147a64.624 64.624 0 0 1-56.07 45.162 89.168 89.168 0 0 1-25.917 175.046Z"/></g></svg><span class="brand-divider" aria-hidden="true"></span><span>Rishe</span></div><h1 data-fit>{{ product.name }}</h1><div class="category" data-fit>{{ product.category }}</div><div class="eyebrow" data-fit>FORM / MATERIAL / DETAIL</div></header>
<main>
 <section class="card hero"><img id="hero-image" src="{{ images.hero.uri }}" alt="{{ product.name }}"><div class="caption" data-fit>{{ product.caption }}</div></section>
 <div class="right">
  <section class="card detail"><div class="detail-copy"><h2 data-fit>{{ product.feature_title }}</h2><p data-fit>{{ product.feature_text }}</p><p data-fit>{{ product.feature_note }}</p></div><div class="detail-media"><img id="detail-image" src="{{ images.detail.uri }}" alt="Product detail"></div></section>
  <section class="card alternate"><img id="alternate-image" src="{{ images.alternate.uri }}" alt="Alternate product view"><div class="alternate-title" data-fit>{{ product.alternate_title }}</div><div class="alternate-note">{{ 'Product photograph' if images.alternate.photograph else 'Studio render' }}</div></section>
  <section class="card dimensions"><div class="dim-label">Dimensions</div>{% if product.dimensions %}<div class="size" data-fit>{{ product.size_text }}</div><div class="axis" data-fit>Width × Height × Depth</div><div class="note" data-fit>{{ product.dimensions.get('note', '') }}</div>{% else %}<div class="size">Not specified</div><div class="note">Add verified dimensions to overview.json</div>{% endif %}</section>
 </div>
</main>
<footer><span>{{ product.collection }}</span><span>{{ product.status }}</span></footer>
<script>
// White studio-render backgrounds become transparent; the card supplies the color.
// Real photos retain their pixels unless white-background removal is opted into.
async function prepareImage(id, removeWhite, trim) {
  const img = document.getElementById(id);
  await img.decode();
  if (!removeWhite) return;
  const canvas = document.createElement('canvas');
  canvas.width = img.naturalWidth;
  canvas.height = img.naturalHeight;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(img, 0, 0);
  const pixels = ctx.getImageData(0, 0, canvas.width, canvas.height);
  const d = pixels.data;
  for (let i = 0; i < d.length; i += 4) {
    const low = Math.min(d[i], d[i + 1], d[i + 2]);
    // Restrict the key to near-white pixels; retain the colored wood surface.
    if (low >= 245) d[i + 3] = 0;
    else if (low > 235) d[i + 3] *= (245 - low) / 10;
  }
  ctx.putImageData(pixels, 0, 0);
  let result = canvas;
  if (trim) {
    let left = canvas.width, top = canvas.height, right = -1, bottom = -1;
    for (let y = 0; y < canvas.height; y++) {
      for (let x = 0; x < canvas.width; x++) {
        if (d[(y * canvas.width + x) * 4 + 3] > 32) {
          left = Math.min(left, x); right = Math.max(right, x);
          top = Math.min(top, y); bottom = Math.max(bottom, y);
        }
      }
    }
    if (right >= left) {
      const width = right - left + 1, height = bottom - top + 1;
      const pad = Math.ceil(Math.max(width, height) * 0.04);
      result = document.createElement('canvas');
      result.width = width + pad * 2; result.height = height + pad * 2;
      result.getContext('2d').drawImage(canvas, left, top, width, height,
                                     pad, pad, width, height);
    }
  }
  img.src = result.toDataURL('image/png');
  await img.decode();
}
window.overviewReady = Promise.all([
  prepareImage('alternate-image', {{ product.get('alternate_remove_white', not images.alternate.photograph) | tojson }}, false),
  prepareImage('detail-image', {{ product.get('detail_remove_white', not images.detail.photograph) | tojson }}, false),
  prepareImage('hero-image', {{ product.get('hero_remove_white', not images.hero.photograph) | tojson }}, {{ product.get('hero_trim', not images.hero.photograph) | tojson }})
]);
</script>
</html>
